# Project Material Risk agent — environment (demo defaults)
# Copy to .env for local runs. Real AI Core creds live outside the repo
# (e.g. /Users/I778959/Documents/Common Repo/BAI-AICore-Credentials.md).

# Demo / mock mode: serve the 15 in-process tools, no SAP/AI Core needed.
IBD_TESTING=1

# Server bind (CF injects PORT; do not hardcode in production).
HOST=0.0.0.0
PORT=5000

# Public URL advertised in the agent card (MTA injects ${default-url} on CF).
# AGENT_PUBLIC_URL=http://localhost:5000/

# --- AI Core (required for the live LLM-orchestrated path) ------------------
# AICORE_CLIENT_ID=
# AICORE_CLIENT_SECRET=
# AICORE_AUTH_URL=
# AICORE_BASE_URL=
# AICORE_RESOURCE_GROUP=default

# --- Live S/4HANA via Business Accelerator Hub sandbox ----------------------
# Set IBD_LIVE_S4=1 to use real S/4 OData data (instead of mock fixtures).
# IBD_TESTING and IBD_LIVE_S4 are mutually exclusive; IBD_TESTING takes priority.
# IBD_LIVE_S4=1
# S4_BASE_URL=https://sandbox.api.sap.com/s4hanacloud/sap/opu/odata/sap
# S4_API_KEY=<your-business-accelerator-hub-apikey>   # NEVER commit — put the real key in .env only
# S4_PLANT=1710                                    # default plant for stock queries
# S4_SERVICE_PROFILE=cloud          # cloud (API_* — BAI sandbox) | onprem (OP_* — Adarsh tenant)

# --- BTP Destination Service (on-prem principal propagation path) -----------
# Active when S4_SERVICE_PROFILE=onprem. The agent calls the BTP Destination
# Service API to resolve the S4 URL + exchange the user's IAS JWT for an S4-scoped
# token (OAuth2SAMLBearerAssertion / PrincipalPropagation). The destination name
# must match the BTP Destination created in INTEGRATION_GUIDE.md Step 10.
# VCAP_SERVICES is injected automatically by CF when the Destination service instance
# is bound to this app — no env var needed for the Destination service credentials.
# S4_DESTINATION=S4_MATERIAL_RISK   # BTP Destination name (must match INTEGRATION_GUIDE §Step 10)

# --- IAS authentication (production Joule → agent hop) ----------------------
# AGENT_AUTH_MODE=ias               # mock | ias | xsuaa (mock auto-set under IBD_TESTING)
# IAS_JWKS_URI=https://<ias-tenant>/oauth2/certs
# IAS_ISSUER=https://<ias-tenant>
# IAS_AUDIENCE=<agent-app-client-id>
# IAS_REQUIRED_API=a2a_custom_agent_app_api

# --- Diagnostics ------------------------------------------------------------
# ENABLE_WHOAMI=1                   # exposes GET /whoami (identity-chain probe). OFF in prod.
