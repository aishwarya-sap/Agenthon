# Environment variables — copy this to .env and fill in values.
# NEVER commit .env to version control.

# ── AI Core (SAP Generative AI Hub) ──────────────────────────────────────────
AICORE_AUTH_URL=
AICORE_BASE_URL=
AICORE_CLIENT_ID=
AICORE_CLIENT_SECRET=
AICORE_RESOURCE_GROUP=default

# ── Agent configuration ───────────────────────────────────────────────────────
AGENT_MODEL=sap/anthropic--claude-4.5-sonnet
AGENT_NAME=agent-starter-kit
AGENT_DESCRIPTION=SAP A2A agent
AGENT_PUBLIC_URL=https://<agent-route>.<cf-domain>/

# ── Run mode ──────────────────────────────────────────────────────────────────
# Sprint 1: IBD_TESTING=1 (fully offline, mock data)
IBD_TESTING=1
# Sprint 2: set IBD_LIVE_S4=1 and remove IBD_TESTING
# IBD_LIVE_S4=1

# ── S/4HANA connectivity (Sprint 2) ──────────────────────────────────────────
# S4_API_KEY=                     # Accelerator Hub API key (sandbox)
# S4_BASE_URL=                    # e.g. https://sandbox.api.sap.com
# S4_SERVICE_PROFILE=cloud        # cloud | onprem

# ── IAS / Joule principal propagation (Sprint 3) ─────────────────────────────
# AGENT_AUTH_MODE=ias
# IAS_ISSUER=
# IAS_AUDIENCE=
# IAS_REQUIRED_API=
# IAS_JWKS_URI=                   # optional; derived from IAS_ISSUER if not set

# ── Diagnostics (Sprint 3) ───────────────────────────────────────────────────
# ENABLE_WHOAMI=1                  # expose /whoami for identity chain debugging (never in prod)

# ── Decision/approval persistence — HANA Cloud (Sprint 4) ────────────────────
# Where the agent persists its recommendations + approvals (append-only audit,
# INSERT/SELECT-only role) and, optionally, the HANA Cloud Vector Engine for
# semantic recall. Default in_memory (Sprint 1 MVP/mock). Set hana + provision a
# HANA Cloud instance for a durable backend table. On CF, bind a HANA
# (HDI-container / schema) service — credentials arrive via VCAP_SERVICES, so no
# secret goes in env. PLACEHOLDER: implement the store before enabling hana.
MEMORY_BACKEND=in_memory           # in_memory | hana
# HANA_HOST=<instance>.hana.<region>.hanacloud.ondemand.com
# HANA_PORT=443
# HANA_USER=<technical user with INSERT/SELECT-only role>
# HANA_PASSWORD=                   # SECRET — env/VCAP only, never commit
# HANA_SCHEMA=ADARSH_AGENT
# HANA_DECISION_TABLE=ZAGENT_DECISION_LOG
# HANA_VECTOR_TABLE=ZAGENT_DECISION_VEC
# HANA_ENCRYPT=true

HOST=0.0.0.0
PORT=5000
