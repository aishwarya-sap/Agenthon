# CF staging: exclude everything the buildpack doesn't need at runtime.
# Without this, cf push uploads .venv (100s MB), test fixtures, eval data,
# and __pycache__ — causing slow uploads and potential import conflicts.

# Python environments and caches
.venv/
.venv*/
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.coverage
coverage.xml
htmlcov/
.pytest_cache/

# Test and eval artefacts (not needed at runtime)
tests/
eval/
test_report.json

# Governance docs (markdown only, not runtime)
governance/

# Development configs
.env
.env.*
!.env.example

# IDE and OS
.DS_Store
.vscode/
.idea/
*.swp
*.swo

# Specification (documentation only)
specification/
