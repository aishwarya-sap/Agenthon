# .env.example — copy to .env and fill in. NEVER commit the real .env.
# In Cloud Foundry these come from bound service credentials (VCAP_SERVICES) or
# `cf set-env`; locally you paste values from your AI Core service key.
# The AI Core service key for this engagement lives OUTSIDE this repo at:
#   /Users/I778959/Documents/Common Repo/BAI-AICore-Credentials.md   (do not copy it in)

# --- Runtime mode -----------------------------------------------------------
# Set IBD_TESTING=1 for fully offline mock mode (no SAP, no AI Core, no secrets).
IBD_TESTING=1

# --- Model access (SAP AI Core via LiteLLM) ---------------------------------
AGENT_MODEL=sap/anthropic--claude-4.5-sonnet
AGENT_MODEL_FALLBACK=sap/anthropic--claude-4.5-haiku
AICORE_CLIENT_ID=<from AI Core service key: clientid>
AICORE_CLIENT_SECRET=<from AI Core service key: clientsecret>
AICORE_AUTH_URL=<from AI Core service key: url>
AICORE_BASE_URL=<from AI Core service key: serviceurls.AI_API_URL>
AICORE_RESOURCE_GROUP=default

# --- SAP connectivity (production; leave unset for mock) --------------------
# gateway (Agent Gateway, preferred) | cloud (S/4HANA Cloud) | onprem (S/4HANA Private Cloud)
SAP_MODE=gateway
# AGW_CREDENTIALS_JSON=<Agent Gateway service key JSON>        # Mode B
# DEST_CLIENT_ID / DEST_CLIENT_SECRET / DEST_AUTH_URL / DEST_SERVICE_URI / DEST_NAME   # Mode C
# CONN_CLIENT_ID / CONN_CLIENT_SECRET / CONN_AUTH_URL / CONN_PROXY_HOST / CONN_PROXY_PORT  # Mode C

# --- BAI end-to-end: SAP Business Accelerator Hub (sandbox S/4 OData, APIKey) ---
# Verified reachable 2026-10-21. BAI test uses the S/4HANA CLOUD API_* services
# (the APIKey resolves these); Adarsh prod uses the on-prem OP_* services. Service
# names are config-driven per env. OData V2 (d.results, /Date(ms)/ dates).
# APIKey is a SECRET -> env/VCAP only, never committed. Rotate if ever exposed.
# SAP_MODE=accelerator_hub
# S4_BASE_URL=https://sandbox.api.sap.com/s4hanacloud/sap/opu/odata/sap
# S4_API_KEY=<SAP Business Accelerator Hub API key - from secure channel>
# S4_SVC_PO=API_PURCHASEORDER_PROCESS_SRV            # Adarsh on-prem: OP_PURCHASEORDER_0001
# S4_SVC_PR=API_PURCHASEREQ_PROCESS_SRV              # Adarsh: OP_PURCHASEREQUISITION_0001
# S4_SVC_MATDOC=API_MATERIAL_DOCUMENT_SRV            # Adarsh: OP_API_MATERIAL_DOCUMENT_SRV (GRN mvt 101)
# S4_SVC_BP=API_BUSINESS_PARTNER                     # Adarsh: OP_API_BUSINESS_PARTNER_SRV
# S4_SVC_INFORECORD=API_INFORECORD_PROCESS_SRV       # Adarsh: OP_API_INFORECORD_PROCESS_SRV_0001
# S4_SVC_CONTRACT=API_PURCHASECONTRACT_PROCESS_SRV   # Adarsh: sap-s4-OP_PPS_PURCHASECONTRACT_0001-v1
# S4_SVC_STOCK=API_MATERIAL_STOCK_SRV                # Adarsh: OP_API_MATERIAL_STOCK_SRV

# --- Inbound identity at the A2A boundary -----------------------------------
# mock (auto when IBD_TESTING=1) | ias (Joule A2A — IAS user token) | xsuaa (legacy)
# | none (DEV-ONLY inbound-auth bypass for BAI standalone testing before Joule — NEVER prod)
AGENT_AUTH_MODE=ias
# IAS token validation (Joule A2A). From the Custom-Agent IAS app + IAS tenant.
IAS_ISSUER=https://<your-ias-tenant>.accounts.ondemand.com
IAS_AUDIENCE=<Custom-Agent app client id>
IAS_REQUIRED_API=a2a_custom_agent_app_api
# IAS_JWKS_URI defaults to <IAS_ISSUER>/oauth2/certs if unset
# IAS_JWKS_URI=https://<your-ias-tenant>.accounts.ondemand.com/oauth2/certs

# --- Diagnostics ------------------------------------------------------------
# /whoami endpoint echoes the inbound token claims + validates each identity hop.
# Enable ONLY for BAI/dev testing; MUST be off (unset) in production.
# ENABLE_WHOAMI=1

# --- Project data source ----------------------------------------------------
# SAP_PS (Phase 2, read from Project System) | EXCEL (Phase 1 structured upload)
PROJECT_DATA_SOURCE=SAP_PS
# PROJECT_DATA_EXCEL_PATH=/path/to/project_schedule.xlsx   # required when PROJECT_DATA_SOURCE=EXCEL

# --- Decision/approval persistence (HANA Cloud) -----------------------------
# Where the agent persists its recommendations + HoD approvals (append-only audit
# of ZAGENT_DECISION_LOG, INSERT/SELECT-only role) and, optionally, the HANA Cloud
# Vector Engine for semantic recall of prior decisions. Default in_memory (MVP/mock).
# Set hana once HANA Cloud is provisioned + the store is implemented. On CF, bind a
# HANA (HDI-container / schema) service — creds arrive via VCAP_SERVICES, not env.
# PLACEHOLDER: app/memory.py::HanaMemoryStore raises until implemented.
MEMORY_BACKEND=in_memory           # in_memory | hana
# HANA_HOST=<instance>.hana.<region>.hanacloud.ondemand.com
# HANA_PORT=443
# HANA_USER=<technical user with INSERT/SELECT-only role>
# HANA_PASSWORD=<secret — env/VCAP only, never commit>
# HANA_SCHEMA=ADARSH_AGENT
# HANA_DECISION_TABLE=ZAGENT_DECISION_LOG
# HANA_VECTOR_TABLE=ZAGENT_DECISION_VEC
# HANA_ENCRYPT=true

# --- Server -----------------------------------------------------------------
HOST=0.0.0.0
PORT=8080
# Must match the CF landscape you deploy to (e.g. us10-001, jp10, ap21). No default —
# set it to the target subaccount's region so the agent card advertises the right URL.
AGENT_PUBLIC_URL=https://procurement-bottleneck-agent.cfapps.<region>.hana.ondemand.com
