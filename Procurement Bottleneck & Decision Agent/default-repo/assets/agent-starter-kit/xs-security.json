{
  "xsappname": "agent-starter-kit",
  "tenant-mode": "dedicated",
  "description": "XSUAA security configuration for agent-starter-kit",
  "scopes": [
    {
      "name": "$XSAPPNAME.agent.read",
      "description": "Read access for agent tools"
    },
    {
      "name": "$XSAPPNAME.agent.invoke",
      "description": "Permission to invoke agent A2A endpoint"
    }
  ],
  "role-templates": [
    {
      "name": "AgentUser",
      "description": "Can invoke the agent",
      "scope-references": [
        "$XSAPPNAME.agent.read",
        "$XSAPPNAME.agent.invoke"
      ]
    }
  ],
  "role-collections": [
    {
      "name": "agent-starter-kit-user",
      "description": "Standard agent user role collection",
      "role-template-references": [
        "$XSAPPNAME.AgentUser"
      ]
    }
  ],
  "oauth2-configuration": {
    "token-validity": 3600,
    "redirect-uris": [
      "https://<your-agent-name>.cfapps.<region>.hana.ondemand.com/**"
    ]
  }
}
