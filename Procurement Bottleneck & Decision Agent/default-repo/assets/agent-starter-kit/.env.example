# .env.example — copy to .env and fill in values. NEVER commit the real .env.
# In Cloud Foundry, secrets come from bound service credentials (VCAP_SERVICES)
# or cf set-env. This file is for local development only.

# ---------------------------------------------------------------------------
# Runtime mode
# ---------------------------------------------------------------------------
# IBD_TESTING=1  → fully offline / mock mode (no SAP, no AI Core, no secrets needed)
# IBD_TESTING=0  → live mode (requires all credentials below)
IBD_TESTING=1

# ---------------------------------------------------------------------------
# SAP AI Core — paste the full service key JSON as a single-line value
# In CF this comes from the aicore service binding (VCAP_SERVICES) automatically.
# ---------------------------------------------------------------------------
# AICORE_SERVICE_KEY='{"serviceurls":{"AI_API_URL":"https://..."},"clientid":"...","clientsecret":"...","url":"https://..."}'
AICORE_RESOURCE_GROUP=default

# ---------------------------------------------------------------------------
# Model selection (must match a deployed model in your AI Core resource group)
# ---------------------------------------------------------------------------
AGENT_MODEL=sap/anthropic--claude-4-5-sonnet
AGENT_MODEL_FALLBACK=sap/anthropic--claude-3-5-haiku

# ---------------------------------------------------------------------------
# Inbound auth at the A2A boundary
# ias   = production (Joule delivers an IAS token — use for all client deployments)
# xsuaa = legacy / direct XSUAA JWT
# none  = DEV-ONLY bypass — NEVER enable in production
# ---------------------------------------------------------------------------
AGENT_AUTH_MODE=ias

# IAS token validation — from the Custom-Agent IAS app registration
IAS_ISSUER=https://<your-ias-tenant>.accounts.ondemand.com
IAS_AUDIENCE=<Custom-Agent app client id>
IAS_REQUIRED_API=a2a_custom_agent_app_api

# ---------------------------------------------------------------------------
# Agent public URL (used in agent card response)
# ---------------------------------------------------------------------------
AGENT_PUBLIC_URL=https://<your-agent-name>.cfapps.<region>.hana.ondemand.com

# ---------------------------------------------------------------------------
# SAP connectivity — Agent Gateway (preferred) or direct Destination
# ---------------------------------------------------------------------------
# AGW_CREDENTIALS_JSON='{"url":"https://...","clientid":"...","clientsecret":"...","tokenurl":"..."}'
# SAP_DESTINATION_URL=https://<your-s4-system>.sap.com

# ---------------------------------------------------------------------------
# Guardrails (optional overrides — defaults are in config.py)
# ---------------------------------------------------------------------------
TOKEN_BUDGET_PER_RUN=50000
RAG_SIMILARITY_GATE=0.80
CIRCUIT_BREAKER_THRESHOLD=3

# ---------------------------------------------------------------------------
# Diagnostics — DEV only, MUST be off in production
# ---------------------------------------------------------------------------
# ENABLE_WHOAMI=1
